# CodeSurgeon Environment Variables Template

# API Keys (required for production)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXX
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXX

# GitHub Integration (optional; required for GitHub PR analysis)
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXX

# LLM Configuration
LLM_PROVIDER=anthropic  # Options: anthropic, openai
LLM_MODEL=claude-3-opus-20240229  # or gpt-4, gpt-3.5-turbo

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT=30

# Cache Configuration
CACHE_TTL_GITHUB=86400  # 24 hours (seconds)
CACHE_TTL_ANALYSIS=3600  # 1 hour (seconds)
CACHE_ENABLED=true

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Testing (optional)
MOCK_LLM=false  # Set to true to mock LLM for testing
MOCK_GITHUB=false  # Set to true to mock GitHub API for testing

# Rate Limiting
GITHUB_API_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2.0  # Exponential backoff multiplier

# Feature Flags
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_PROFILING=false
